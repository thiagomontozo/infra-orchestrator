# Generate secrets with scripts/bootstrap.ps1 or scripts/bootstrap.sh. Never commit .env.
APP_NAME=infra-orchestrator
APP_ENV=production
HTTP_PORT=8080
HTTP_ADDRESS=:8080
PUBLIC_ORIGIN=https://infra.example.com
FRONTEND_PORT=8080
# Interface do host para publicar a UI. 127.0.0.1 restringe ao proprio host.
FRONTEND_BIND=127.0.0.1
POSTGRES_PASSWORD=
DATABASE_URL=postgres://orchestrator:REPLACE@localhost:5432/orchestrator?sslmode=require
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222
# Base64 of 32 random bytes; keep stable and back up separately.
ENCRYPTION_KEY=
SECRET_BACKEND=local
VAULT_ADDR=
VAULT_TOKEN=
VAULT_MOUNT=secret
SESSION_TTL=8h
LOG_LEVEL=info
SSH_CONNECT_TIMEOUT=10s
SSH_COMMAND_TIMEOUT=90s
SSH_KNOWN_HOSTS=
SSH_AUTH_SOCK=
# Explicit egress allowlist. Empty denies all destinations (including public IPs).
# Example for controlled private hosts: 10.0.0.0/8,192.168.0.0/16
OUTBOUND_ALLOWED_CIDRS=
WORKER_CONCURRENCY=4
EMBEDDED_WORKER=true
LLM_REQUEST_TIMEOUT=60s
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
PROMETHEUS_ENABLED=true
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://infra.example.com/api/v1/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_GROUP_CLAIM=groups
OIDC_ROLE_MAPPING={}
# Active Directory: o proprio usuario faz o bind (login@LDAP_DOMAIN); nao ha conta de servico.
# LDAP_SERVER aceita host, host:porta ou URL completa; sem esquema assume ldap://host:389.
LDAP_SERVER=
LDAP_DOMAIN=
# Diretorio generico: conta de pesquisa dedicada sobre LDAPS.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
# Derivado de LDAP_DOMAIN quando vazio (CORP.EXAMPLE.COM -> DC=CORP,DC=EXAMPLE,DC=COM).
LDAP_BASE_DN=
# Padrao: (sAMAccountName=%s) com LDAP_DOMAIN, (uid=%s) sem ele.
LDAP_USER_FILTER=
LDAP_GROUP_ATTRIBUTE=memberOf
LDAP_ROLE_MAPPING={}
# Em ldap:// a conexao e promovida por StartTLS; LDAP_ALLOW_PLAINTEXT=true permite seguir sem cifra
# quando o controlador de dominio nao publica certificado (a senha trafega em claro na rede interna).
LDAP_STARTTLS=true
LDAP_ALLOW_PLAINTEXT=false
LDAP_TLS_SKIP_VERIFY=false
# PEM da CA interna que assina o certificado do controlador de dominio, quando ela nao esta
# no trust store do container. Preenchido, dispensa LDAP_TLS_SKIP_VERIFY.
LDAP_CA_CERT=
